{$DOMAIN} {
	encode zstd gzip
	# Signaling WebSocket
	handle /ws {
		reverse_proxy server:8000
	}
	handle /healthz {
		reverse_proxy server:8000
	}
	# Game files. Precompressed .br/.gz files (made by the build) are served when present.
	handle {
		root * /srv/web
		file_server {
			precompressed br gzip
		}
		@engine path *.wasm *.pck
		header @engine Cache-Control "public, max-age=3600"
		header /index.html Cache-Control "no-cache"
	}
}
